{
  "name": "ground-rules",
  "version": "0.1.0",
  "private": true,
  "description": "Five Claude Code mods that keep an agent to the ground rules.",
  "license": "MIT",
  "type": "module",
  "repository": "github:ivanvyd/ground-rules",
  "engines": { "node": ">=22" },
  "scripts": {
    "validate": "node scripts/each-plugin.mjs validate",
    "test": "node scripts/each-plugin.mjs test",
    "reach": "node scripts/check-reach.mjs",
    "reach:write": "node scripts/check-reach.mjs --write",
    "types": "node scripts/sync-types.mjs",
    "typecheck": "tsc -p .",
    "smoke": "node scripts/smoke-install.mjs",
    "check": "npm run validate && npm run test && npm run reach"
  }
}
